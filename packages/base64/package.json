{
  "name": "@toolbocks/base64",
  "version": "1.0.0",
  "description": "Encode and Decode data to and from Base64. Compatible with any environment, as it includes a fallback implementation of the Base64 algorithms when native support is missing",
  "main": "./src/Base64Utils.cjs",
  "dependencies": {
    "@toolbocks/core": "^1.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "scripts": {
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bockelman-scott/bocktils.git"
  },
  "_publishes": [
    {
      "BASE_64_ENCODER": {
        "id": "base64.encoder",
        "name": "base64Encoder",
        "component": "Base64Encoder"
      }
    },
    {
      "BASE_64_DECODER": {
        "id": "base64.decoder",
        "name": "base64Decoder",
        "component": "Base64Decoder"
      }
    }
  ]
}
